# dependencies (installed fresh inside the image with npm ci)
node_modules
.pnp
.pnp.*

# build output (rebuilt inside the image)
.next
out
build
tsconfig.tsbuildinfo

# version control / tooling
.git
.gitignore
.vercel
.vscode
.idea
coverage
.DS_Store
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never bake secrets into the image)
.env*
!.env.example

# docker meta (no need to copy into the image)
Dockerfile*
.dockerignore
docker-compose*.yml

# docs, archives and local one-off scripts not needed at runtime
*.md
_archive
scripts
.image-manifest.json
